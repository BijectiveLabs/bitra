# Copy to .env. `tra live --env-file .env` and docker compose read it; nothing reads it silently.

# A trade key: ContractTrade Order + Position, no wallet permissions, bound to this machine's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Model providers (docs/providers.md). One is enough; the config names which.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
# TRA_OPENAI_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible server (ollama, local)
