# Copy to .env. Every `tra` command reads the .env beside strategy.toml, and docker compose reads it too; a key set in the shell wins.

# A trade key: ContractTrade Order + Position, no wallet permissions, bound to this machine's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Model providers (docs/providers.md). One is enough; the config names which.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
9ROUTER_API_KEY=
# TRA_OPENAI_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible server (ollama, local)
