# Copy to .env. `tra live --env-file .env` and docker compose read it; nothing reads it silently.

# A trade key: ContractTrade Order + Position, no wallet permissions, bound to this machine's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# The research agent's model provider (layers 0, 2 and 3 only; never on the order path).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TRA_OPENAI_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible server
