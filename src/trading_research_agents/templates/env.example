# Copy to .env and fill in. `tra live --env-file .env` reads it; nothing reads it silently.
# A trade key: ContractTrade Order + Position, no wallet permissions, bound to this machine's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Model providers (docs.bijectivelabs.dev/opensource/providers). One is enough; the config names which.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
9ROUTER_API_KEY=
